# Copy to .env and fill in.  Load it with your shell, e.g.:
#   set -a && . ./.env && set +a          (bash)
#
# Neither key is required unless you use `manimations assets`.

# Freesound — sound effects.  Free key: https://freesound.org/apiv2/apply
# Results default to the CC0 licence filter, so no attribution is required.
FREESOUND_API_KEY=

# Jamendo — background music.  Free client id: https://devportal.jamendo.com/
# Jamendo is Creative Commons (not CC0), so downloaded tracks need credit; the
# credits file records the author and licence for you.
JAMENDO_CLIENT_ID=
